<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Shared industrial HMI palette.
        These resources are deliberately native WPF so the trainer application
        stays dependency-light and still runs on a clean Windows developer PC.
    -->
    <Color x:Key="HmiBackgroundColor">#0E171D</Color>
    <Color x:Key="HmiPanelColor">#16242C</Color>
    <Color x:Key="HmiPanelAltColor">#20313B</Color>
    <Color x:Key="HmiStrokeColor">#3C5563</Color>
    <Color x:Key="HmiTextColor">#EAF2F7</Color>
    <Color x:Key="HmiMutedTextColor">#AFC1CD</Color>
    <Color x:Key="HmiAccentColor">#42B8A5</Color>
    <Color x:Key="HmiBlueColor">#5EC8FF</Color>
    <Color x:Key="HmiWarningColor">#FFC857</Color>
    <Color x:Key="HmiDangerColor">#E33F3A</Color>
    <Color x:Key="HmiGreenColor">#52D273</Color>

    <SolidColorBrush x:Key="HmiBackgroundBrush" Color="{StaticResource HmiBackgroundColor}" />
    <SolidColorBrush x:Key="HmiPanelBrush" Color="{StaticResource HmiPanelColor}" />
    <SolidColorBrush x:Key="HmiPanelAltBrush" Color="{StaticResource HmiPanelAltColor}" />
    <SolidColorBrush x:Key="HmiStrokeBrush" Color="{StaticResource HmiStrokeColor}" />
    <SolidColorBrush x:Key="HmiTextBrush" Color="{StaticResource HmiTextColor}" />
    <SolidColorBrush x:Key="HmiMutedTextBrush" Color="{StaticResource HmiMutedTextColor}" />
    <SolidColorBrush x:Key="HmiAccentBrush" Color="{StaticResource HmiAccentColor}" />
    <SolidColorBrush x:Key="HmiBlueBrush" Color="{StaticResource HmiBlueColor}" />
    <SolidColorBrush x:Key="HmiWarningBrush" Color="{StaticResource HmiWarningColor}" />
    <SolidColorBrush x:Key="HmiDangerBrush" Color="{StaticResource HmiDangerColor}" />
    <SolidColorBrush x:Key="HmiGreenBrush" Color="{StaticResource HmiGreenColor}" />

    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    <!-- Section headers are used for real equipment context, Digital Twin, and status panels. -->
    <Style x:Key="HmiSectionHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource HmiTextBrush}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- Compact labels keep equipment state dense without looking like a default WPF form. -->
    <Style x:Key="HmiSmallLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource HmiMutedTextBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Standard framed card for HMI state groups and sidebar summaries. -->
    <Style x:Key="HmiStatusCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HmiPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HmiStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,0,10,10" />
    </Style>

    <!-- Panel border for larger Machine Twin regions such as the photo and vector twin. -->
    <Style x:Key="HmiPanelBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HmiPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HmiStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <!-- Chamber cards show role, recipe, door, and wafer/process state. -->
    <Style x:Key="HmiChamberCard" TargetType="Border" BasedOn="{StaticResource HmiPanelBorder}">
        <Setter Property="Background" Value="{StaticResource HmiPanelAltBrush}" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <!-- FOUP slot chips are small because operators scan many slots repeatedly. -->
    <Style x:Key="HmiFoupSlotChip" TargetType="Border">
        <Setter Property="Background" Value="#22333C" />
        <Setter Property="BorderBrush" Value="#4D6572" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Margin" Value="2" />
    </Style>

    <!-- Base command style. Feature buttons derive from this instead of default gray WPF buttons. -->
    <Style x:Key="HmiButton" TargetType="Button">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Foreground" Value="{StaticResource HmiTextBrush}" />
        <Setter Property="Background" Value="#274652" />
        <Setter Property="BorderBrush" Value="#527282" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Primary action for simulator sequence runs and normal operator commands. -->
    <Style x:Key="HmiPrimaryButton" TargetType="Button" BasedOn="{StaticResource HmiButton}">
        <Setter Property="Background" Value="{StaticResource HmiAccentBrush}" />
        <Setter Property="BorderBrush" Value="#7CE5D4" />
        <Setter Property="Foreground" Value="#071115" />
    </Style>

    <!-- Secondary action for stop/reset style commands that should be visible but calmer. -->
    <Style x:Key="HmiSecondaryButton" TargetType="Button" BasedOn="{StaticResource HmiButton}">
        <Setter Property="Background" Value="#233842" />
        <Setter Property="BorderBrush" Value="#6A8795" />
        <Setter Property="Foreground" Value="{StaticResource HmiTextBrush}" />
    </Style>

    <!-- Emergency Stop intentionally uses a stronger color and larger text. -->
    <Style x:Key="HmiDangerButton" TargetType="Button" BasedOn="{StaticResource HmiButton}">
        <Setter Property="Background" Value="{StaticResource HmiDangerBrush}" />
        <Setter Property="BorderBrush" Value="#FF928F" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- Alarm badges keep safety state visible even when the operator is focused on the twin. -->
    <Style x:Key="HmiAlarmBadge" TargetType="Border">
        <Setter Property="Background" Value="#3A2525" />
        <Setter Property="BorderBrush" Value="{StaticResource HmiDangerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,5" />
    </Style>

    <!-- LED indicator style for tower lamp, sensors, vacuum, and cylinder state. -->
    <Style x:Key="HmiLed" TargetType="Ellipse">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Stroke" Value="#A9BAC3" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Fill" Value="#2D3C44" />
    </Style>

    <!-- Event-log list keeps capture/debug output readable inside the runtime HMI. -->
    <Style x:Key="HmiEventLogList" TargetType="ListBox">
        <Setter Property="Background" Value="#101A20" />
        <Setter Property="Foreground" Value="{StaticResource HmiTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HmiStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- The main tab frame is styled globally so every tab feels like one HMI shell. -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource HmiBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HmiStrokeBrush}" />
    </Style>

    <!-- Tab headers stay compact; Machine Twin is selected by MainWindow at startup. -->
    <Style TargetType="TabItem">
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Margin" Value="0,0,3,0" />
        <Setter Property="Foreground" Value="{StaticResource HmiMutedTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
