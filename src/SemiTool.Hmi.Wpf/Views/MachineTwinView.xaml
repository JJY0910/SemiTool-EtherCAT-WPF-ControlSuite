<UserControl x:Class="SemiTool.Hmi.Wpf.Views.MachineTwinView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SemiTool.Hmi.Wpf.ViewModels">
    <UserControl.Resources>
        <Style x:Key="SlotChipStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Background" Value="#24343C" />
            <Setter Property="BorderBrush" Value="#49616E" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasWafer}" Value="True">
                    <Setter Property="Background" Value="#24533F" />
                    <Setter Property="BorderBrush" Value="#64DB9D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChamberCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Background" Value="#24343C" />
            <Setter Property="BorderBrush" Value="#5B7684" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource HmiBackgroundBrush}" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#111E25"
                BorderBrush="{StaticResource HmiStrokeBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,14">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Machine Twin"
                               Foreground="{StaticResource HmiTextBrush}"
                               FontSize="28"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Runtime simulator Digital Twin / limited theta station swing / no real hardware claim"
                               Foreground="{StaticResource HmiMutedTextBrush}"
                               FontSize="13" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource HmiStatusCard}" Margin="0,0,8,0" Padding="10,6">
                        <TextBlock Text="{Binding ModeLabel}" Foreground="{StaticResource HmiGreenBrush}" FontWeight="SemiBold" />
                    </Border>
                    <Border Style="{StaticResource HmiStatusCard}" Margin="0,0,8,0" Padding="10,6">
                        <TextBlock Text="{Binding ConnectionLabel}" Foreground="{StaticResource HmiTextBrush}" FontWeight="SemiBold" />
                    </Border>
                    <Button Content="EMERGENCY STOP"
                            Command="{Binding EmergencyStopCommand}"
                            Style="{StaticResource HmiDangerButton}"
                            MinWidth="170"
                            MinHeight="48" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource HmiStatusCard}">
                    <StackPanel>
                        <TextBlock Text="Real equipment context reference" Style="{StaticResource HmiSectionHeader}" />
                        <Border Background="#0A1115"
                                BorderBrush="{StaticResource HmiStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="4">
                            <Image Source="{Binding ReferencePhotoPath}"
                                   Stretch="Uniform"
                                   Height="250" />
                        </Border>
                        <TextBlock Text="{Binding PhotoCaption}"
                                   Foreground="{StaticResource HmiMutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="Approved portfolio context photo. It does not claim WPF real-hardware verification."
                                   Foreground="{StaticResource HmiWarningBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource HmiStatusCard}">
                    <StackPanel>
                        <TextBlock Text="FOUP A" Style="{StaticResource HmiSectionHeader}" />
                        <ItemsControl ItemsSource="{Binding FoupASlots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FoupSlotChipViewModel}">
                                    <Border Style="{StaticResource SlotChipStyle}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource HmiTextBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text="wafer" Foreground="{StaticResource HmiMutedTextBrush}" FontSize="10">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasWafer}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="FOUP B" Style="{StaticResource HmiSectionHeader}" Margin="0,16,0,8" />
                        <ItemsControl ItemsSource="{Binding FoupBSlots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FoupSlotChipViewModel}">
                                    <Border Style="{StaticResource SlotChipStyle}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource HmiTextBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text="wafer" Foreground="{StaticResource HmiMutedTextBrush}" FontSize="10">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasWafer}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource HmiAlarmBadge}">
                    <StackPanel>
                        <TextBlock Text="Alarm Summary" Foreground="White" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AlarmSummary}" Foreground="{StaticResource HmiMutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="1"
                    Style="{StaticResource HmiStatusCard}"
                    Padding="10"
                    Margin="0,0,10,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Live Simulator Digital Twin" Style="{StaticResource HmiSectionHeader}" />
                            <TextBlock Text="{Binding FeedbackBoundary}" Foreground="{StaticResource HmiMutedTextBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Run Simulator Demo"
                                    Command="{Binding RunSimulatorDemoCommand}"
                                    Style="{StaticResource HmiPrimaryButton}" />
                            <Button Content="Stop"
                                    Command="{Binding StopCommand}"
                                    Style="{StaticResource HmiButton}" />
                            <Button Content="Reset"
                                    Command="{Binding ResetCommand}"
                                    Style="{StaticResource HmiButton}" />
                        </StackPanel>
                    </StackPanel>

                    <Viewbox Grid.Row="1" Stretch="Uniform">
                        <Canvas Width="700" Height="540" Background="#10191F">
                            <Rectangle Canvas.Left="28" Canvas.Top="28" Width="644" Height="484" RadiusX="10" RadiusY="10"
                                       Fill="#334149" Stroke="#A9BAC3" StrokeThickness="2" />
                            <Rectangle Canvas.Left="46" Canvas.Top="46" Width="608" Height="448" RadiusX="8" RadiusY="8"
                                       Fill="#202B32" Stroke="#D5E3EA" StrokeThickness="1" Opacity="0.85" />
                            <TextBlock Canvas.Left="56" Canvas.Top="54" Text="Transparent cover / aluminum base" Foreground="{StaticResource HmiMutedTextBrush}" />

                            <Path Data="M 138,418 C 88,272 158,124 350,92 C 542,124 612,272 562,418"
                                  Stroke="{StaticResource HmiBlueBrush}"
                                  StrokeThickness="4"
                                  StrokeDashArray="8 5"
                                  Fill="Transparent" />
                            <TextBlock Canvas.Left="228" Canvas.Top="142"
                                       Text="Limited theta station arc"
                                       Foreground="{StaticResource HmiTextBrush}"
                                       FontSize="15"
                                       FontWeight="SemiBold" />

                            <Border Canvas.Left="94" Canvas.Top="398" Width="112" Height="58" Style="{StaticResource ChamberCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="FOUP A" Foreground="White" FontWeight="SemiBold" />
                                    <TextBlock Text="Source / A1-A5" Foreground="{StaticResource HmiMutedTextBrush}" FontSize="11" />
                                </StackPanel>
                            </Border>
                            <Border Canvas.Left="60" Canvas.Top="242" Width="126" Height="66" Style="{StaticResource ChamberCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Chamber A" Foreground="White" FontWeight="SemiBold" />
                                    <TextBlock Text="PreClean" Foreground="{StaticResource HmiMutedTextBrush}" FontSize="11" />
                                    <TextBlock Text="Door open" Foreground="{StaticResource HmiGreenBrush}" FontSize="11"
                                               Visibility="{Binding ChamberADoorOpen, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                            <Border Canvas.Left="284" Canvas.Top="70" Width="132" Height="66" Style="{StaticResource ChamberCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Chamber B" Foreground="White" FontWeight="SemiBold" />
                                    <TextBlock Text="CMP_Main" Foreground="{StaticResource HmiMutedTextBrush}" FontSize="11" />
                                    <TextBlock Text="Door open" Foreground="{StaticResource HmiGreenBrush}" FontSize="11"
                                               Visibility="{Binding ChamberBDoorOpen, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                            <Border Canvas.Left="514" Canvas.Top="242" Width="126" Height="66" Style="{StaticResource ChamberCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Chamber C" Foreground="White" FontWeight="SemiBold" />
                                    <TextBlock Text="PostClean_Dry" Foreground="{StaticResource HmiMutedTextBrush}" FontSize="11" />
                                    <TextBlock Text="Door open" Foreground="{StaticResource HmiGreenBrush}" FontSize="11"
                                               Visibility="{Binding ChamberCDoorOpen, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                            <Border Canvas.Left="494" Canvas.Top="398" Width="112" Height="58" Style="{StaticResource ChamberCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="FOUP B" Foreground="White" FontWeight="SemiBold" />
                                    <TextBlock Text="Destination" Foreground="{StaticResource HmiMutedTextBrush}" FontSize="11" />
                                </StackPanel>
                            </Border>

                            <Ellipse Canvas.Left="294" Canvas.Top="244" Width="112" Height="112" Fill="#1E2B33" Stroke="#DBE7EC" StrokeThickness="4" />
                            <Ellipse Canvas.Left="324" Canvas.Top="274" Width="52" Height="52" Fill="#647883" Stroke="#EAF2F7" StrokeThickness="2" />
                            <TextBlock Canvas.Left="318" Canvas.Top="334" Text="Theta base" Foreground="White" FontWeight="SemiBold" />

                            <Canvas Canvas.Left="350" Canvas.Top="300">
                                <Grid Width="54" Height="246" Canvas.Left="-27" Canvas.Top="-246" RenderTransformOrigin="0.5,1">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleY="{Binding BladeScaleY}" />
                                            <RotateTransform Angle="{Binding VisualThetaAngle}" />
                                        </TransformGroup>
                                    </Grid.RenderTransform>
                                    <Rectangle Width="30" Height="150" HorizontalAlignment="Center" VerticalAlignment="Bottom" RadiusX="8" RadiusY="8"
                                               Fill="#A9B7BE" Stroke="#EAF2F7" StrokeThickness="2" />
                                    <Rectangle Width="42" Height="112" HorizontalAlignment="Center" VerticalAlignment="Top" RadiusX="8" RadiusY="8"
                                               Fill="#E2E8EC" Stroke="#F8FBFD" StrokeThickness="2" />
                                    <Ellipse Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                                             Fill="#6BC29B" Stroke="#D9F8EA" StrokeThickness="2"
                                             Visibility="{Binding IsWaferOnBlade, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </Canvas>

                            <Ellipse Canvas.Left="118" Canvas.Top="426" Width="24" Height="24" Fill="#6BC29B" Stroke="#D9F8EA" StrokeThickness="2"
                                     Visibility="{Binding IsWaferInFoupA1, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Ellipse Canvas.Left="111" Canvas.Top="270" Width="24" Height="24" Fill="#6BC29B" Stroke="#D9F8EA" StrokeThickness="2"
                                     Visibility="{Binding IsWaferInChamberA, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Ellipse Canvas.Left="338" Canvas.Top="104" Width="24" Height="24" Fill="#6BC29B" Stroke="#D9F8EA" StrokeThickness="2"
                                     Visibility="{Binding IsWaferInChamberB, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Ellipse Canvas.Left="562" Canvas.Top="270" Width="24" Height="24" Fill="#6BC29B" Stroke="#D9F8EA" StrokeThickness="2"
                                     Visibility="{Binding IsWaferInChamberC, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Ellipse Canvas.Left="532" Canvas.Top="426" Width="24" Height="24" Fill="#6BC29B" Stroke="#D9F8EA" StrokeThickness="2"
                                     Visibility="{Binding IsWaferInFoupB1, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <StackPanel Canvas.Left="604" Canvas.Top="70">
                                <TextBlock Text="Tower" Foreground="White" FontWeight="SemiBold" />
                                <Ellipse Margin="0,5,0,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource HmiLed}">
                                            <Setter Property="Fill" Value="#4B2526" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TowerRed}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource HmiDangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Ellipse Margin="0,5,0,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource HmiLed}">
                                            <Setter Property="Fill" Value="#5B481E" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TowerYellow}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource HmiWarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Ellipse Margin="0,5,0,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource HmiLed}">
                                            <Setter Property="Fill" Value="#244B35" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TowerGreen}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource HmiGreenBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </StackPanel>
                        </Canvas>
                    </Viewbox>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource HmiStatusCard}">
                    <StackPanel>
                        <TextBlock Text="Motion / Actuator State" Style="{StaticResource HmiSectionHeader}" />
                        <TextBlock Text="{Binding CurrentStepName}" Foreground="{StaticResource HmiTextBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CurrentStation, StringFormat=Current station: {0}}" Foreground="{StaticResource HmiMutedTextBrush}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding ThetaTargetName, StringFormat=Theta target: {0}}" Foreground="{StaticResource HmiMutedTextBrush}" />
                        <TextBlock Text="{Binding VisualThetaAngle, StringFormat=Visual angle: {0:F0} deg}" Foreground="{StaticResource HmiMutedTextBrush}" />
                        <TextBlock Text="{Binding PreservedThetaEncoderValue, StringFormat=Encoder target: {0}}" Foreground="{StaticResource HmiWarningBrush}" />
                        <TextBlock Text="{Binding ZState}" Foreground="{StaticResource HmiTextBrush}" Margin="0,8,0,0" />
                        <ProgressBar Height="12" Minimum="0" Maximum="1" Value="{Binding BladeScaleY, Mode=OneWay}" Margin="0,4,0,8" />
                        <TextBlock Text="{Binding CylinderState}" Foreground="{StaticResource HmiMutedTextBrush}" />
                        <TextBlock Text="{Binding VacuumState}" Foreground="{StaticResource HmiMutedTextBrush}" />
                        <TextBlock Text="{Binding WaferSummary}" Foreground="{StaticResource HmiGreenBrush}" FontWeight="SemiBold" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource HmiStatusCard}">
                    <StackPanel>
                        <TextBlock Text="Station Detents" Style="{StaticResource HmiSectionHeader}" />
                        <ItemsControl ItemsSource="{Binding Stations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MachineTwinStationViewModel}">
                                    <Border CornerRadius="4" Padding="8" Margin="0,0,0,6" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1C2A32" />
                                                <Setter Property="BorderBrush" Value="#3F5866" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Background" Value="#1D4F43" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource HmiAccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                            <TextBlock Text="{Binding ThetaEncoderPosition}" Foreground="{StaticResource HmiMutedTextBrush}" DockPanel.Dock="Right" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource HmiStatusCard}">
                    <StackPanel>
                        <TextBlock Text="Runtime Event Trace" Style="{StaticResource HmiSectionHeader}" />
                        <ItemsControl ItemsSource="{Binding EventLogLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource HmiMutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,5" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="#111E25"
                BorderBrush="{StaticResource HmiStrokeBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,8">
            <DockPanel>
                <TextBlock Text="{Binding EquipmentKind}" Foreground="{StaticResource HmiMutedTextBrush}" DockPanel.Dock="Left" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Auto Start" Command="{Binding AutoStartCommand}" Style="{StaticResource HmiPrimaryButton}" />
                    <Button Content="Auto Stop" Command="{Binding AutoStopCommand}" Style="{StaticResource HmiButton}" />
                    <Button Content="Reset" Command="{Binding ResetCommand}" Style="{StaticResource HmiButton}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
