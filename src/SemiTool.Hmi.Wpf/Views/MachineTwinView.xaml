<UserControl x:Class="SemiTool.Hmi.Wpf.Views.MachineTwinView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SemiTool.Hmi.Wpf.ViewModels"
             xmlns:design="clr-namespace:SemiTool.Hmi.Wpf.DesignTime"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=design:DesignMachineTwinViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="820"
             d:DesignWidth="1280"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="SlotChipStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Margin" Value="1.5" />
            <Setter Property="Background" Value="#24343C" />
            <Setter Property="BorderBrush" Value="#49616E" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasWafer}" Value="True">
                    <Setter Property="Background" Value="#24533F" />
                    <Setter Property="BorderBrush" Value="#64DB9D" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="#6B5426" />
                    <Setter Property="BorderBrush" Value="{StaticResource HmiWarningBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChamberCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Background" Value="#24343C" />
            <Setter Property="BorderBrush" Value="#5B7684" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource HmiBackgroundBrush}" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#111E25"
                BorderBrush="{StaticResource HmiStrokeBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,14">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Wafer Transfer Sequence Monitor"
                               Foreground="{StaticResource HmiTextBrush}"
                               FontSize="28"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Machine Twin / limited theta station swing / simulator-mode sequence monitor"
                               Foreground="{StaticResource HmiMutedTextBrush}"
                               FontSize="13" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource HmiStatusCard}" Margin="0,0,8,0" Padding="10,6">
                        <TextBlock Text="{Binding ModeLabel}" Foreground="{StaticResource HmiGreenBrush}" FontWeight="SemiBold" />
                    </Border>
                    <Border Style="{StaticResource HmiStatusCard}" Margin="0,0,8,0" Padding="10,6">
                        <TextBlock Text="{Binding ConnectionLabel}" Foreground="{StaticResource HmiTextBrush}" FontWeight="SemiBold" />
                    </Border>
                    <Button Content="EMERGENCY STOP"
                            Command="{Binding EmergencyStopCommand}"
                            Style="{StaticResource HmiDangerButton}"
                            MinWidth="170"
                            MinHeight="48" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource HmiStatusCard}">
                    <StackPanel>
                        <TextBlock Text="Real equipment context reference" Style="{StaticResource HmiSectionHeader}" />
                        <Border Background="#0A1115"
                                BorderBrush="{StaticResource HmiStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="4">
                            <Image Source="{Binding ReferencePhotoPath}"
                                   Stretch="Uniform"
                                   Height="105" />
                        </Border>
                        <TextBlock Text="{Binding PhotoCaption}"
                                   Foreground="{StaticResource HmiMutedTextBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Margin="0,5,0,0" />
                        <TextBlock Text="Approved portfolio context photo. It does not claim WPF real-hardware verification."
                                   Foreground="{StaticResource HmiWarningBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource HmiStatusCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- FOUPs are shown as vertical 5-slot cassette stacks so the runtime UI mirrors the pipeline state, not a single symbolic button. -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="FOUP A" Style="{StaticResource HmiSectionHeader}" />
                            <TextBlock Text="{Binding FoupASummary}" Foreground="{StaticResource HmiMutedTextBrush}" Margin="0,0,0,4" FontSize="12" />
                            <ItemsControl ItemsSource="{Binding FoupASlots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FoupSlotChipViewModel}">
                                        <Border Style="{StaticResource SlotChipStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="23" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{StaticResource HmiTextBrush}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                                <Ellipse Grid.Column="1" Width="11" Height="11" Fill="#6BC29B" Stroke="#D9F8EA" StrokeThickness="1" VerticalAlignment="Center"
                                                         Visibility="{Binding HasWafer, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding WaferId}" Foreground="{StaticResource HmiGreenBrush}" FontWeight="SemiBold" FontSize="10" />
                                                    <TextBlock Text=" " />
                                                    <TextBlock Text="{Binding State}" Foreground="{StaticResource HmiMutedTextBrush}" FontSize="10" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="FOUP B" Style="{StaticResource HmiSectionHeader}" />
                            <TextBlock Text="{Binding FoupBSummary}" Foreground="{StaticResource HmiMutedTextBrush}" Margin="0,0,0,4" FontSize="12" />
                            <ItemsControl ItemsSource="{Binding FoupBSlots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FoupSlotChipViewModel}">
                                        <Border Style="{StaticResource SlotChipStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="23" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{StaticResource HmiTextBrush}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                                <Ellipse Grid.Column="1" Width="11" Height="11" Fill="#6BC29B" Stroke="#D9F8EA" StrokeThickness="1" VerticalAlignment="Center"
                                                         Visibility="{Binding HasWafer, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding WaferId}" Foreground="{StaticResource HmiGreenBrush}" FontWeight="SemiBold" FontSize="10" />
                                                    <TextBlock Text=" " />
                                                    <TextBlock Text="{Binding State}" Foreground="{StaticResource HmiMutedTextBrush}" FontSize="10" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource HmiAlarmBadge}">
                    <StackPanel>
                        <TextBlock Text="Alarm Summary" Foreground="White" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AlarmSummary}" Foreground="{StaticResource HmiMutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="1"
                    Style="{StaticResource HmiStatusCard}"
                    Padding="10"
                    Margin="0,0,10,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Wafer Transfer Sequence" Style="{StaticResource HmiSectionHeader}" />
                            <TextBlock Text="{Binding FeedbackBoundary}" Foreground="{StaticResource HmiMutedTextBrush}" />
                        </StackPanel>
                        <Border Background="#1B3540"
                                BorderBrush="{StaticResource HmiAccentBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,8"
                                Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Current Sequence Step"
                                           Foreground="{StaticResource HmiMutedTextBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CurrentAction}"
                                           Foreground="{StaticResource HmiTextBrush}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <UniformGrid Columns="5" Margin="0,8,0,0">
                            <Border Style="{StaticResource HmiStatusCard}" Padding="8" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Wafer" Foreground="{StaticResource HmiMutedTextBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding OperationWafer}" Foreground="{StaticResource HmiGreenBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HmiStatusCard}" Padding="8" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Source" Foreground="{StaticResource HmiMutedTextBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding OperationSource}" Foreground="{StaticResource HmiTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HmiStatusCard}" Padding="8" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Destination" Foreground="{StaticResource HmiMutedTextBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding OperationDestination}" Foreground="{StaticResource HmiTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HmiStatusCard}" Padding="8" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Current Step" Foreground="{StaticResource HmiMutedTextBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding OperationCurrentStep}" Foreground="{StaticResource HmiWarningBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HmiStatusCard}" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Next Step" Foreground="{StaticResource HmiMutedTextBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding OperationNextStep}" Foreground="{StaticResource HmiTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Run Transfer Sequence"
                                    Command="{Binding RunTransferSequenceCommand}"
                                    Style="{StaticResource HmiPrimaryButton}" />
                            <Button Content="Pause"
                                    Command="{Binding PauseCommand}"
                                    Style="{StaticResource HmiButton}" />
                            <Button Content="Resume"
                                    Command="{Binding ResumeCommand}"
                                    Style="{StaticResource HmiButton}" />
                            <Button Content="Step Once"
                                    Command="{Binding StepOnceCommand}"
                                    Style="{StaticResource HmiButton}" />
                            <Button Content="Stop"
                                    Command="{Binding StopCommand}"
                                    Style="{StaticResource HmiButton}" />
                            <Button Content="Reset"
                                    Command="{Binding ResetCommand}"
                                    Style="{StaticResource HmiButton}" />
                            <TextBlock Text="Sequence Speed" Foreground="{StaticResource HmiMutedTextBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                            <ComboBox ItemsSource="{Binding SequenceSpeedOptions}"
                                      SelectedItem="{Binding SelectedSequenceSpeed}"
                                      Width="110"
                                      MinHeight="34" />
                        </StackPanel>
                    </StackPanel>

                    <Viewbox Grid.Row="1" Stretch="Uniform">
                        <Canvas Width="700" Height="540" Background="#10191F">
                            <Rectangle Canvas.Left="28" Canvas.Top="28" Width="644" Height="484" RadiusX="10" RadiusY="10"
                                       Fill="#334149" Stroke="#A9BAC3" StrokeThickness="2" />
                            <Rectangle Canvas.Left="46" Canvas.Top="46" Width="608" Height="448" RadiusX="8" RadiusY="8"
                                       Fill="#202B32" Stroke="#D5E3EA" StrokeThickness="1" Opacity="0.85" />
                            <TextBlock Canvas.Left="56" Canvas.Top="54" Text="Transparent cover / aluminum base" Foreground="{StaticResource HmiMutedTextBrush}" />

                            <Path Data="M 138,418 C 88,272 158,124 350,92 C 542,124 612,272 562,418"
                                  Stroke="{StaticResource HmiBlueBrush}"
                                  StrokeThickness="4"
                                  StrokeDashArray="8 5"
                                  Fill="Transparent" />
                            <TextBlock Canvas.Left="228" Canvas.Top="142"
                                       Text="Limited θ station arc"
                                       Foreground="{StaticResource HmiTextBrush}"
                                       FontSize="15"
                                       FontWeight="SemiBold" />

                            <Border Canvas.Left="94" Canvas.Top="398" Width="112" Height="58" Style="{StaticResource ChamberCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="FOUP A" Foreground="White" FontWeight="SemiBold" />
                                    <TextBlock Text="Source / A1-A5" Foreground="{StaticResource HmiMutedTextBrush}" FontSize="11" />
                                </StackPanel>
                            </Border>
                            <Border Canvas.Left="42" Canvas.Top="226" Width="170" Height="112" Style="{StaticResource ChamberCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Chamber A / Pre-Clean" Foreground="White" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ChamberA.Summary}" Foreground="{StaticResource HmiGreenBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding ChamberA.RecipeName}" Foreground="{StaticResource HmiMutedTextBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding ChamberA.CurrentStep}" Foreground="{StaticResource HmiMutedTextBrush}" FontSize="11" />
                                    <ProgressBar Height="7" Minimum="0" Maximum="100" Value="{Binding ChamberA.ProgressPercent, Mode=OneWay}" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding ChamberA.RemainingTime, StringFormat=Remain {0}s}" Foreground="{StaticResource HmiMutedTextBrush}" FontSize="10" />
                                    <TextBlock Text="{Binding ChamberADoorState, StringFormat=Door: {0}}" Foreground="{StaticResource HmiWarningBrush}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="Door open" Foreground="{StaticResource HmiGreenBrush}" FontSize="11"
                                               Visibility="{Binding ChamberADoorOpen, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                            <Border Canvas.Left="264" Canvas.Top="58" Width="172" Height="112" Style="{StaticResource ChamberCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Chamber B / CMP Main" Foreground="White" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ChamberB.Summary}" Foreground="{StaticResource HmiGreenBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding ChamberB.RecipeName}" Foreground="{StaticResource HmiMutedTextBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding ChamberB.CurrentStep}" Foreground="{StaticResource HmiMutedTextBrush}" FontSize="11" />
                                    <ProgressBar Height="7" Minimum="0" Maximum="100" Value="{Binding ChamberB.ProgressPercent, Mode=OneWay}" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding ChamberB.RemainingTime, StringFormat=Remain {0}s}" Foreground="{StaticResource HmiMutedTextBrush}" FontSize="10" />
                                    <TextBlock Text="{Binding ChamberBDoorState, StringFormat=Door: {0}}" Foreground="{StaticResource HmiWarningBrush}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="Door open" Foreground="{StaticResource HmiGreenBrush}" FontSize="11"
                                               Visibility="{Binding ChamberBDoorOpen, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                            <Border Canvas.Left="488" Canvas.Top="226" Width="174" Height="112" Style="{StaticResource ChamberCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Chamber C / Post-Clean" Foreground="White" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ChamberC.Summary}" Foreground="{StaticResource HmiGreenBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding ChamberC.RecipeName}" Foreground="{StaticResource HmiMutedTextBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding ChamberC.CurrentStep}" Foreground="{StaticResource HmiMutedTextBrush}" FontSize="11" />
                                    <ProgressBar Height="7" Minimum="0" Maximum="100" Value="{Binding ChamberC.ProgressPercent, Mode=OneWay}" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding ChamberC.RemainingTime, StringFormat=Remain {0}s}" Foreground="{StaticResource HmiMutedTextBrush}" FontSize="10" />
                                    <TextBlock Text="{Binding ChamberCDoorState, StringFormat=Door: {0}}" Foreground="{StaticResource HmiWarningBrush}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="Door open" Foreground="{StaticResource HmiGreenBrush}" FontSize="11"
                                               Visibility="{Binding ChamberCDoorOpen, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                            <Border Canvas.Left="494" Canvas.Top="398" Width="112" Height="58" Style="{StaticResource ChamberCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="FOUP B" Foreground="White" FontWeight="SemiBold" />
                                    <TextBlock Text="Destination" Foreground="{StaticResource HmiMutedTextBrush}" FontSize="11" />
                                </StackPanel>
                            </Border>

                            <Ellipse Canvas.Left="294" Canvas.Top="244" Width="112" Height="112" Fill="#1E2B33" Stroke="#DBE7EC" StrokeThickness="4" />
                            <Ellipse Canvas.Left="324" Canvas.Top="274" Width="52" Height="52" Fill="#647883" Stroke="#EAF2F7" StrokeThickness="2" />
                            <TextBlock Canvas.Left="318" Canvas.Top="334" Text="Theta base" Foreground="White" FontWeight="SemiBold" />

                            <Canvas Canvas.Left="350" Canvas.Top="300">
                                <Grid Width="54" Height="246" Canvas.Left="-27" Canvas.Top="-246" RenderTransformOrigin="0.5,1">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleY="{Binding BladeScaleY}" />
                                            <RotateTransform Angle="{Binding VisualThetaAngle}" />
                                        </TransformGroup>
                                    </Grid.RenderTransform>
                                    <Rectangle Width="30" Height="150" HorizontalAlignment="Center" VerticalAlignment="Bottom" RadiusX="8" RadiusY="8"
                                               Fill="#A9B7BE" Stroke="#EAF2F7" StrokeThickness="2" />
                                    <Rectangle Width="42" Height="112" HorizontalAlignment="Center" VerticalAlignment="Top" RadiusX="8" RadiusY="8"
                                               Fill="#E2E8EC" Stroke="#F8FBFD" StrokeThickness="2" />
                                    <Ellipse Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                                             Fill="#6BC29B" Stroke="#D9F8EA" StrokeThickness="2"
                                             Visibility="{Binding IsWaferOnBlade, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </Canvas>

                            <Ellipse Canvas.Left="118" Canvas.Top="426" Width="24" Height="24" Fill="#6BC29B" Stroke="#D9F8EA" StrokeThickness="2"
                                     Visibility="{Binding IsWaferInFoupA1, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Ellipse Canvas.Left="111" Canvas.Top="270" Width="24" Height="24" Fill="#6BC29B" Stroke="#D9F8EA" StrokeThickness="2"
                                     Visibility="{Binding IsWaferInChamberA, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Ellipse Canvas.Left="338" Canvas.Top="104" Width="24" Height="24" Fill="#6BC29B" Stroke="#D9F8EA" StrokeThickness="2"
                                     Visibility="{Binding IsWaferInChamberB, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Ellipse Canvas.Left="562" Canvas.Top="270" Width="24" Height="24" Fill="#6BC29B" Stroke="#D9F8EA" StrokeThickness="2"
                                     Visibility="{Binding IsWaferInChamberC, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Ellipse Canvas.Left="532" Canvas.Top="426" Width="24" Height="24" Fill="#6BC29B" Stroke="#D9F8EA" StrokeThickness="2"
                                     Visibility="{Binding IsWaferInFoupB1, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <StackPanel Canvas.Left="604" Canvas.Top="70">
                                <TextBlock Text="Tower" Foreground="White" FontWeight="SemiBold" />
                                <Ellipse Margin="0,5,0,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource HmiLed}">
                                            <Setter Property="Fill" Value="#4B2526" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TowerRed}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource HmiDangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Ellipse Margin="0,5,0,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource HmiLed}">
                                            <Setter Property="Fill" Value="#5B481E" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TowerYellow}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource HmiWarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Ellipse Margin="0,5,0,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource HmiLed}">
                                            <Setter Property="Fill" Value="#244B35" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TowerGreen}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource HmiGreenBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </StackPanel>
                        </Canvas>
                    </Viewbox>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource HmiStatusCard}">
                    <StackPanel>
                        <TextBlock Text="Motion / Actuator State" Style="{StaticResource HmiSectionHeader}" />
                        <TextBlock Text="{Binding PipelineState, StringFormat=Pipeline: {0}}" Foreground="{StaticResource HmiGreenBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CurrentTransferDescription}" Foreground="{StaticResource HmiMutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,8" />
                        <TextBlock Text="{Binding CurrentStepName}" Foreground="{StaticResource HmiTextBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <UniformGrid Columns="2" Margin="0,10,0,8">
                            <Border Style="{StaticResource HmiStatusCard}" Padding="8" Margin="0,0,6,6">
                                <StackPanel>
                                    <TextBlock Text="Robot" Foreground="{StaticResource HmiMutedTextBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding RobotSequenceState}" Foreground="{StaticResource HmiGreenBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HmiStatusCard}" Padding="8" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="Blade" Foreground="{StaticResource HmiMutedTextBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding BladeSequenceState}" Foreground="{StaticResource HmiGreenBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HmiStatusCard}" Padding="8" Margin="0,0,6,6">
                                <StackPanel>
                                    <TextBlock Text="Vacuum" Foreground="{StaticResource HmiMutedTextBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding VacuumDisplayState}" Foreground="{StaticResource HmiWarningBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HmiStatusCard}" Padding="8" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="Sequence" Foreground="{StaticResource HmiMutedTextBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding SelectedSequenceSpeed}" Foreground="{StaticResource HmiTextBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock Text="{Binding ChamberADoorState, StringFormat=Chamber A Door: {0}}" Foreground="{StaticResource HmiMutedTextBrush}" />
                        <TextBlock Text="{Binding ChamberBDoorState, StringFormat=Chamber B Door: {0}}" Foreground="{StaticResource HmiMutedTextBrush}" />
                        <TextBlock Text="{Binding ChamberCDoorState, StringFormat=Chamber C Door: {0}}" Foreground="{StaticResource HmiMutedTextBrush}" />
                        <TextBlock Text="{Binding CurrentStation, StringFormat=Current station: {0}}" Foreground="{StaticResource HmiMutedTextBrush}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding ThetaTargetName, StringFormat=Theta target: {0}}" Foreground="{StaticResource HmiMutedTextBrush}" />
                        <TextBlock Text="{Binding VisualThetaAngle, StringFormat=Visual angle: {0:F0} deg}" Foreground="{StaticResource HmiMutedTextBrush}" />
                        <TextBlock Text="{Binding PreservedThetaEncoderValue, StringFormat=Encoder target: {0}}" Foreground="{StaticResource HmiWarningBrush}" />
                        <TextBlock Text="{Binding ZState}" Foreground="{StaticResource HmiTextBrush}" Margin="0,8,0,0" />
                        <ProgressBar Height="12" Minimum="0" Maximum="1" Value="{Binding BladeScaleY, Mode=OneWay}" Margin="0,4,0,8" />
                        <TextBlock Text="{Binding CylinderState}" Foreground="{StaticResource HmiMutedTextBrush}" />
                        <TextBlock Text="{Binding VacuumState}" Foreground="{StaticResource HmiMutedTextBrush}" />
                        <TextBlock Text="{Binding WaferSummary}" Foreground="{StaticResource HmiGreenBrush}" FontWeight="SemiBold" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource HmiStatusCard}">
                    <StackPanel>
                        <TextBlock Text="Station Detents" Style="{StaticResource HmiSectionHeader}" />
                        <ItemsControl ItemsSource="{Binding Stations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MachineTwinStationViewModel}">
                                    <Border CornerRadius="4" Padding="8" Margin="0,0,0,6" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1C2A32" />
                                                <Setter Property="BorderBrush" Value="#3F5866" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Background" Value="#1D4F43" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource HmiAccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                            <TextBlock Text="{Binding ThetaEncoderPosition}" Foreground="{StaticResource HmiMutedTextBrush}" DockPanel.Dock="Right" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource HmiStatusCard}">
                    <StackPanel>
                        <TextBlock Text="Runtime Event Trace" Style="{StaticResource HmiSectionHeader}" />
                        <ItemsControl ItemsSource="{Binding EventLogLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource HmiMutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,5" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="#111E25"
                BorderBrush="{StaticResource HmiStrokeBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,8">
            <DockPanel>
                <TextBlock Text="{Binding EquipmentKind}" Foreground="{StaticResource HmiMutedTextBrush}" DockPanel.Dock="Left" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Auto Start" Command="{Binding AutoStartCommand}" Style="{StaticResource HmiPrimaryButton}" />
                    <Button Content="Auto Stop" Command="{Binding AutoStopCommand}" Style="{StaticResource HmiButton}" />
                    <Button Content="Reset" Command="{Binding ResetCommand}" Style="{StaticResource HmiButton}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
