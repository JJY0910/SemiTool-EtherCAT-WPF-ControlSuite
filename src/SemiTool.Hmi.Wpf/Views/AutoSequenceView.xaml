<UserControl x:Class="SemiTool.Hmi.Wpf.Views.AutoSequenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <GroupBox Header="Sequence Status">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding SequenceName}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StepDescription}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Step" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StepNumber}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Elapsed" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Elapsed}" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Timeout" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Timeout}" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="Commands">
                <UniformGrid Columns="1">
                    <Button Content="Start" Command="{Binding StartCommand}" />
                    <Button Content="Pause / Resume" Command="{Binding PauseCommand}" />
                    <Button Content="Stop" Command="{Binding StopCommand}" />
                    <Button Content="Reset" Command="{Binding ResetCommand}" />
                </UniformGrid>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="Transfer Queue">
                <ListBox ItemsSource="{Binding TransferQueue}" />
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
