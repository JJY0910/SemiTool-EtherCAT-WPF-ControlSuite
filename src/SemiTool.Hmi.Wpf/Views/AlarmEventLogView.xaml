<UserControl x:Class="SemiTool.Hmi.Wpf.Views.AlarmEventLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <GroupBox Header="Alarms">
            <DataGrid ItemsSource="{Binding Alarms}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="130" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170" />
                    <DataGridTextColumn Header="Cause" Binding="{Binding Cause}" Width="*" />
                    <DataGridTextColumn Header="Recovery" Binding="{Binding RecoveryAction}" Width="*" />
                    <DataGridTextColumn Header="Occurred" Binding="{Binding OccurredTime}" Width="190" />
                    <DataGridTextColumn Header="Cleared" Binding="{Binding ClearedTime}" Width="190" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        <GroupBox Grid.Row="1" Header="Event Log">
            <DataGrid ItemsSource="{Binding Events}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="190" />
                    <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="80" />
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="180" />
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        <Button Grid.Row="2"
                HorizontalAlignment="Right"
                Content="Export Log CSV"
                Command="{Binding ExportCommand}" />
    </Grid>
</UserControl>
