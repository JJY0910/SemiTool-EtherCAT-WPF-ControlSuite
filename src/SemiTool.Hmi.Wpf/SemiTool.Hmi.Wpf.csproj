<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SemiTool.Application\SemiTool.Application.csproj" />
    <ProjectReference Include="..\SemiTool.Domain\SemiTool.Domain.csproj" />
    <ProjectReference Include="..\SemiTool.Hardware\SemiTool.Hardware.csproj" />
    <ProjectReference Include="..\SemiTool.Infrastructure\SemiTool.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\config\EquipmentProfile.finaltest.json" Link="config\EquipmentProfile.finaltest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\images\real-equipment-context-top-view.jpg" Link="Assets\real-equipment-context-top-view.jpg" CopyToOutputDirectory="PreserveNewest" />
    <!--
      Local-only vendor DLL support for real equipment PCs.
      The DLL is intentionally ignored by git and is copied only when it exists,
      so public CI and Simulator mode builds never require IEG3268_Dll.dll.
    -->
    <None Include="..\..\libs\IEG3268_Dll.dll" Condition="Exists('..\..\libs\IEG3268_Dll.dll')" CopyToOutputDirectory="PreserveNewest" Link="libs\IEG3268_Dll.dll" />
  </ItemGroup>

</Project>
