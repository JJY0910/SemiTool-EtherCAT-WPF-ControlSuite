<Window x:Class="SemiTool.EtherCAT.ControlSuite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:SemiTool.EtherCAT.ControlSuite.Models"
        mc:Ignorable="d"
        Title="SemiTool EtherCAT Wafer Transfer Control Trainer"
        Width="1520"
        Height="960"
        MinWidth="1280"
        MinHeight="820"
        Background="#EEF2F7"
        FontFamily="Malgun Gothic"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <SolidColorBrush x:Key="NavyBrush" Color="#0B1F48" />
        <SolidColorBrush x:Key="BlueBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="SteelBrush" Color="#CBD5E1" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CanvasBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="ReadyBrush" Color="#16A34A" />
        <SolidColorBrush x:Key="ActiveBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />
        <SolidColorBrush x:Key="FaultBrush" Color="#DC2626" />
        <SolidColorBrush x:Key="OfflineBrush" Color="#64748B" />
        <SolidColorBrush x:Key="TextBrush" Color="#172033" />
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="SmallLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="#CCD6E3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border" BasedOn="{StaticResource PanelStyle}">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="StatePillStyle" TargetType="Border">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="74" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{StaticResource ReadyBrush}" />
            <Setter Property="Padding" Value="10,2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:EquipmentState.Active}">
                    <Setter Property="Background" Value="{StaticResource ActiveBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:EquipmentState.Warning}">
                    <Setter Property="Background" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:EquipmentState.Fault}">
                    <Setter Property="Background" Value="{StaticResource FaultBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:EquipmentState.Offline}">
                    <Setter Property="Background" Value="{StaticResource OfflineBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StateDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Fill" Value="{StaticResource ReadyBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:EquipmentState.Active}">
                    <Setter Property="Fill" Value="{StaticResource ActiveBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:EquipmentState.Warning}">
                    <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:EquipmentState.Fault}">
                    <Setter Property="Fill" Value="{StaticResource FaultBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:EquipmentState.Offline}">
                    <Setter Property="Fill" Value="{StaticResource OfflineBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Background" Value="{StaticResource NavyBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource NavyBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
        </Style>

        <Style x:Key="SwitchFaceStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Stroke" Value="#111827" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="Fill" Value="#111827" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HardwareColor}" Value="Red">
                    <Setter Property="Fill" Value="#DC2626" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HardwareColor}" Value="Green">
                    <Setter Property="Fill" Value="#16A34A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HardwareColor}" Value="EmergencyRed">
                    <Setter Property="Fill" Value="#B91C1C" />
                    <Setter Property="Stroke" Value="#FCA5A5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPressed}" Value="True">
                    <Setter Property="Stroke" Value="#FACC15" />
                    <Setter Property="StrokeThickness" Value="5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid MinWidth="1430" MinHeight="880" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="78" />
                <RowDefinition Height="*" />
                <RowDefinition Height="188" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource NavyBrush}" CornerRadius="8" Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="반도체 웨이퍼 이송 제어 트레이너"
                                   Foreground="White"
                                   FontSize="26"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding OperatorMessage}"
                                   Foreground="#BFDBFE"
                                   FontSize="13"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="EquipmentStateBadge"
                                CornerRadius="16"
                                Padding="16,6"
                                MinWidth="128">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource ReadyBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EquipmentState}" Value="{x:Static models:EquipmentState.Active}">
                                            <Setter Property="Background" Value="{StaticResource ActiveBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EquipmentState}" Value="{x:Static models:EquipmentState.Warning}">
                                            <Setter Property="Background" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EquipmentState}" Value="{x:Static models:EquipmentState.Fault}">
                                            <Setter Property="Background" Value="{StaticResource FaultBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding EquipmentState}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" />
                        </Border>
                        <Border Background="#1E3A8A" CornerRadius="16" Padding="16,6" Margin="10,0,0,0">
                            <TextBlock Text="{Binding OperationMode}" Foreground="White" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,14,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Margin="0,0,14,10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="전면 제어반 / I/O" Style="{StaticResource SectionTitleStyle}" />
                            <ItemsControl ItemsSource="{Binding StatusItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Style="{StaticResource StateDotStyle}" VerticalAlignment="Top" Margin="0,5,10,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource ValueTextStyle}" />
                                                <TextBlock Text="{Binding Value}" Foreground="{StaticResource NavyBrush}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource SmallLabelStyle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="티칭값 보호" Style="{StaticResource SectionTitleStyle}" />
                            <!-- 실제 티칭 좌표는 이 화면에 하드코딩하지 않습니다. 승인 소스 연결 상태만 표시합니다. -->
                            <TextBlock Text="{Binding TeachingStatus}" Style="{StaticResource ValueTextStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="좌표/오프셋/보정값 수정 금지" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="170" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="장비 구조도 기반 운전 화면" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{Binding SelectedRoute}" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{StaticResource BlueBrush}" FontWeight="Bold" />
                            </Grid>

                            <Viewbox Grid.Row="1" Stretch="Uniform">
                                <Canvas Width="760" Height="540" Background="{StaticResource CanvasBrush}">
                                    <!-- 알루미늄 프로파일 프레임과 아크릴 안전 커버 영역입니다. -->
                                    <Rectangle Canvas.Left="70" Canvas.Top="40" Width="620" Height="420" RadiusX="6" RadiusY="6" Fill="#E2E8F0" Stroke="#94A3B8" StrokeThickness="3" />
                                    <Polygon Points="92,60 668,60 640,118 120,118" Fill="#EFF6FF" Stroke="#93C5FD" StrokeThickness="2" Opacity="0.78" />
                                    <Rectangle Canvas.Left="90" Canvas.Top="70" Width="580" Height="360" Fill="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1.5" />
                                    <Line X1="90" Y1="430" X2="670" Y2="430" Stroke="#64748B" StrokeThickness="4" />

                                    <!-- 중앙 회전/선형 이송부: 실제 축 위치는 드라이브 피드백 연결 전까지 LIVE N/A로 유지합니다. -->
                                    <Ellipse Canvas.Left="270" Canvas.Top="190" Width="220" Height="220" Fill="#E5E7EB" Stroke="#64748B" StrokeThickness="4" />
                                    <Ellipse Canvas.Left="300" Canvas.Top="220" Width="160" Height="160" Fill="#F8FAFC" Stroke="#94A3B8" StrokeThickness="3" />
                                    <Ellipse Canvas.Left="357" Canvas.Top="277" Width="46" Height="46" Fill="#CBD5E1" Stroke="#475569" StrokeThickness="2" />
                                    <Rectangle Canvas.Left="338" Canvas.Top="130" Width="84" Height="175" RadiusX="6" RadiusY="6" Fill="#E2E8F0" Stroke="#475569" StrokeThickness="2" RenderTransformOrigin="0.5,0.9">
                                        <Rectangle.RenderTransform>
                                            <RotateTransform Angle="-10" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Rectangle Canvas.Left="352" Canvas.Top="158" Width="56" Height="106" RadiusX="4" RadiusY="4" Fill="#F8FAFC" Stroke="#64748B" StrokeThickness="1.5" RenderTransformOrigin="0.5,1">
                                        <Rectangle.RenderTransform>
                                            <RotateTransform Angle="-10" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Ellipse Canvas.Left="362" Canvas.Top="246" Width="36" Height="36" Fill="#FFFFFF" Stroke="#2563EB" StrokeThickness="2" />
                                    <TextBlock Canvas.Left="337" Canvas.Top="408" Text="중앙 이송부" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" />
                                    <TextBlock Canvas.Left="323" Canvas.Top="430" Text="회전 베이스 / 픽업 헤드" FontSize="11" Foreground="{StaticResource MutedBrush}" />

                                    <!-- 케이블 캐리어와 공압 튜브 표시입니다. -->
                                    <Path Data="M 458,278 C 522,238 568,270 580,330 C 588,374 552,402 500,392"
                                          Stroke="#111827"
                                          StrokeThickness="18"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                    <Path Data="M 458,278 C 522,238 568,270 580,330 C 588,374 552,402 500,392"
                                          Stroke="#EF4444"
                                          StrokeThickness="3"
                                          StrokeDashArray="8 10" />
                                    <Path Data="M 442,250 C 506,188 590,210 624,256" Stroke="#93C5FD" StrokeThickness="4" StrokeEndLineCap="Round" />

                                    <!-- 챔버 A/B/C: 장비 사진의 전면 슬롯, 푸시 버튼, 웨이퍼 스테이지를 단순화했습니다. -->
                                    <Border Canvas.Left="315" Canvas.Top="74" Width="130" Height="88" Background="White" BorderBrush="#94A3B8" BorderThickness="2" CornerRadius="5">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="26" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="CHAMBER A" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" />
                                            <Rectangle Grid.Row="1" Margin="18,10,18,20" Fill="#CBD5E1" Stroke="#64748B" />
                                            <Ellipse Grid.Row="1" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Fill="#16A34A" Stroke="#0F5132" />
                                        </Grid>
                                    </Border>
                                    <Border Canvas.Left="135" Canvas.Top="165" Width="128" Height="98" Background="White" BorderBrush="#94A3B8" BorderThickness="2" CornerRadius="5">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="26" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="CHAMBER B" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" />
                                            <Ellipse Grid.Row="1" Width="54" Height="22" Fill="#E5E7EB" Stroke="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Ellipse Grid.Row="1" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Fill="#16A34A" Stroke="#0F5132" />
                                        </Grid>
                                    </Border>
                                    <Border Canvas.Left="505" Canvas.Top="165" Width="128" Height="98" Background="White" BorderBrush="#94A3B8" BorderThickness="2" CornerRadius="5">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="26" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="CHAMBER C" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" />
                                            <Ellipse Grid.Row="1" Width="54" Height="22" Fill="#E5E7EB" Stroke="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Ellipse Grid.Row="1" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" Fill="#16A34A" Stroke="#0F5132" />
                                        </Grid>
                                    </Border>

                                    <!-- FOUP 카세트는 5단 웨이퍼 슬롯을 기준으로 표시합니다. -->
                                    <Border Canvas.Left="142" Canvas.Top="300" Width="90" Height="112" Background="#111827" BorderBrush="#475569" BorderThickness="2" CornerRadius="4">
                                        <Grid Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <Rectangle Grid.Row="0" Fill="#1F2937" Stroke="#94A3B8" />
                                            <Rectangle Grid.Row="1" Fill="#1F2937" Stroke="#94A3B8" Margin="0,4,0,0" />
                                            <Rectangle Grid.Row="2" Fill="#1F2937" Stroke="#94A3B8" Margin="0,4,0,0" />
                                            <Rectangle Grid.Row="3" Fill="#1F2937" Stroke="#94A3B8" Margin="0,4,0,0" />
                                            <Rectangle Grid.Row="4" Fill="#1F2937" Stroke="#94A3B8" Margin="0,4,0,0" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Canvas.Left="154" Canvas.Top="416" Text="FOUP A" Foreground="{StaticResource NavyBrush}" FontWeight="Bold" />

                                    <Border Canvas.Left="530" Canvas.Top="300" Width="90" Height="112" Background="#111827" BorderBrush="#475569" BorderThickness="2" CornerRadius="4">
                                        <Grid Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <Rectangle Grid.Row="0" Fill="#1F2937" Stroke="#94A3B8" />
                                            <Rectangle Grid.Row="1" Fill="#1F2937" Stroke="#94A3B8" Margin="0,4,0,0" />
                                            <Rectangle Grid.Row="2" Fill="#1F2937" Stroke="#94A3B8" Margin="0,4,0,0" />
                                            <Rectangle Grid.Row="3" Fill="#1F2937" Stroke="#94A3B8" Margin="0,4,0,0" />
                                            <Rectangle Grid.Row="4" Fill="#1F2937" Stroke="#94A3B8" Margin="0,4,0,0" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Canvas.Left="542" Canvas.Top="416" Text="FOUP B" Foreground="{StaticResource NavyBrush}" FontWeight="Bold" />

                                    <!-- 타워 라이트: 빨강/주황/초록 상태등 위치 표시입니다. -->
                                    <StackPanel Canvas.Left="102" Canvas.Top="70" Width="22">
                                        <Rectangle Height="24" RadiusX="4" RadiusY="4" Fill="#DC2626" Stroke="#7F1D1D" />
                                        <Rectangle Height="24" RadiusX="4" RadiusY="4" Fill="#F59E0B" Stroke="#92400E" Margin="0,2,0,0" />
                                        <Rectangle Height="24" RadiusX="4" RadiusY="4" Fill="#16A34A" Stroke="#14532D" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Canvas.Left="636" Canvas.Top="70" Width="22">
                                        <Rectangle Height="24" RadiusX="4" RadiusY="4" Fill="#DC2626" Stroke="#7F1D1D" />
                                        <Rectangle Height="24" RadiusX="4" RadiusY="4" Fill="#F59E0B" Stroke="#92400E" Margin="0,2,0,0" />
                                        <Rectangle Height="24" RadiusX="4" RadiusY="4" Fill="#16A34A" Stroke="#14532D" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- 전면 제어반 내부 구조: 전원, 서보 드라이브, EtherCAT I/O 위치를 블록으로 구분합니다. -->
                                    <Rectangle Canvas.Left="122" Canvas.Top="462" Width="516" Height="56" Fill="#1F2937" Stroke="#475569" StrokeThickness="2" />
                                    <Rectangle Canvas.Left="138" Canvas.Top="474" Width="58" Height="32" Fill="#EAB308" Stroke="#854D0E" />
                                    <TextBlock Canvas.Left="148" Canvas.Top="482" Text="MCCB" FontSize="11" FontWeight="Bold" Foreground="#111827" />
                                    <Rectangle Canvas.Left="206" Canvas.Top="474" Width="58" Height="32" Fill="#EAB308" Stroke="#854D0E" />
                                    <TextBlock Canvas.Left="222" Canvas.Top="482" Text="MC" FontSize="11" FontWeight="Bold" Foreground="#111827" />
                                    <Rectangle Canvas.Left="274" Canvas.Top="474" Width="72" Height="32" Fill="#EAB308" Stroke="#854D0E" />
                                    <TextBlock Canvas.Left="291" Canvas.Top="482" Text="DC" FontSize="11" FontWeight="Bold" Foreground="#111827" />
                                    <Rectangle Canvas.Left="356" Canvas.Top="470" Width="38" Height="40" Fill="#111827" Stroke="#94A3B8" />
                                    <Rectangle Canvas.Left="402" Canvas.Top="470" Width="38" Height="40" Fill="#111827" Stroke="#94A3B8" />
                                    <Rectangle Canvas.Left="448" Canvas.Top="470" Width="38" Height="40" Fill="#111827" Stroke="#94A3B8" />
                                    <TextBlock Canvas.Left="363" Canvas.Top="480" Text="DRV" FontSize="10" Foreground="White" />
                                    <TextBlock Canvas.Left="409" Canvas.Top="480" Text="DRV" FontSize="10" Foreground="White" />
                                    <TextBlock Canvas.Left="455" Canvas.Top="480" Text="DRV" FontSize="10" Foreground="White" />
                                    <Rectangle Canvas.Left="505" Canvas.Top="472" Width="110" Height="36" Fill="#0F172A" Stroke="#38BDF8" />
                                    <TextBlock Canvas.Left="526" Canvas.Top="482" Text="EtherCAT I/O" FontSize="11" Foreground="White" FontWeight="Bold" />

                                    <Line X1="280" Y1="150" X2="382" Y2="111" Stroke="#2563EB" StrokeThickness="1.5" />
                                    <TextBlock Canvas.Left="212" Canvas.Top="139" Text="선형 이송 액추에이터" FontSize="11" Foreground="{StaticResource NavyBrush}" />
                                    <Line X1="492" Y1="306" X2="594" Y2="332" Stroke="#2563EB" StrokeThickness="1.5" />
                                    <TextBlock Canvas.Left="592" Canvas.Top="326" Text="케이블 캐리어" FontSize="11" Foreground="{StaticResource NavyBrush}" />
                                    <Line X1="208" Y1="330" X2="318" Y2="318" Stroke="#2563EB" StrokeThickness="1.5" />
                                    <TextBlock Canvas.Left="92" Canvas.Top="326" Text="5단 슬롯" FontSize="11" Foreground="{StaticResource NavyBrush}" />
                                    <Line X1="555" Y1="214" X2="646" Y2="176" Stroke="#2563EB" StrokeThickness="1.5" />
                                    <TextBlock Canvas.Left="636" Canvas.Top="164" Text="챔버 슬롯" FontSize="11" Foreground="{StaticResource NavyBrush}" />
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Margin="0,0,6,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="챔버 상태" Style="{StaticResource SectionTitleStyle}" />
                                <ItemsControl ItemsSource="{Binding Chambers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" />
                                                        <Ellipse Style="{StaticResource StateDotStyle}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding EquipmentTag}" Style="{StaticResource SmallLabelStyle}" TextWrapping="Wrap" Margin="0,4,0,6" />
                                                    <TextBlock Text="{Binding PrimaryStatus}" FontSize="12" />
                                                    <TextBlock Text="{Binding SecondaryStatus}" FontSize="12" />
                                                    <TextBlock Text="{Binding InterlockStatus}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Margin="6,0,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="FOUP 상태" Style="{StaticResource SectionTitleStyle}" />
                                <ItemsControl ItemsSource="{Binding Foups}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" />
                                                        <Ellipse Style="{StaticResource StateDotStyle}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding EquipmentTag}" Style="{StaticResource SmallLabelStyle}" TextWrapping="Wrap" Margin="0,4,0,6" />
                                                    <TextBlock Text="{Binding PrimaryStatus}" FontSize="12" />
                                                    <TextBlock Text="{Binding SecondaryStatus}" FontSize="12" />
                                                    <TextBlock Text="{Binding InterlockStatus}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid Grid.Column="2" Margin="14,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="조작 스위치 박스" Style="{StaticResource SectionTitleStyle}" />
                            <ItemsControl ItemsSource="{Binding SwitchInputs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ToggleSwitchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Margin="0,0,10,10"
                                                Padding="0">
                                            <StackPanel>
                                                <Grid Width="78" Height="62">
                                                    <Ellipse Style="{StaticResource SwitchFaceStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <TextBlock Text="ON" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding IsPressed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </Grid>
                                                <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="{Binding Detail}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource SmallLabelStyle}" Width="132" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="이송 경로 / 운전 명령" Style="{StaticResource SectionTitleStyle}" />
                            <WrapPanel>
                                <Button Content="FOUP A -> CHAMBER A" Command="{Binding SelectRouteCommand}" CommandParameter="FOUP A -> CHAMBER A" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Content="FOUP A -> CHAMBER B" Command="{Binding SelectRouteCommand}" CommandParameter="FOUP A -> CHAMBER B" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Content="FOUP B -> CHAMBER C" Command="{Binding SelectRouteCommand}" CommandParameter="FOUP B -> CHAMBER C" Style="{StaticResource SecondaryButtonStyle}" />
                            </WrapPanel>
                            <WrapPanel Margin="0,4,0,0">
                                <Button Content="START CHECK" Command="{Binding StartCycleCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Content="HOLD" Command="{Binding HoldCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Content="RESET" Command="{Binding ResetCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Content="SERVO READY" Command="{Binding ServoReadyCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Content="HOME CHECK" Command="{Binding HomeRequestCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource PanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="시퀀스 진행도" Style="{StaticResource SectionTitleStyle}" />
                            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                <ProgressBar Height="18" Minimum="0" Maximum="100" Value="{Binding SequenceProgress}" Foreground="{StaticResource ActiveBrush}" Background="#E2E8F0" />
                                <TextBlock Text="{Binding SequenceProgress, StringFormat={}{0}%}" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding SequenceSteps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="72" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="24" Height="24" CornerRadius="12" Background="#DBEAFE" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding StepNo}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource StatePillStyle}">
                                                <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Margin="0,0,14,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="축 상태 / 알람 이벤트" Style="{StaticResource SectionTitleStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48*" />
                                <ColumnDefinition Width="52*" />
                            </Grid.ColumnDefinitions>
                            <ItemsControl Grid.Column="0" ItemsSource="{Binding AxisStatuses}" Margin="0,0,14,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="82" />
                                                <ColumnDefinition Width="82" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource StateDotStyle}" Margin="0,4,8,0" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Position}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                            <TextBlock Grid.Column="2" Text="{Binding Servo}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                            <TextBlock Grid.Column="3" Text="{Binding Home}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding AlarmEvents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="66" />
                                                <ColumnDefinition Width="88" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding Source}" Foreground="{StaticResource NavyBrush}" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{StaticResource TextBrush}" FontSize="12" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="개발 진행" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="UI 셸: 구현 중" Style="{StaticResource ValueTextStyle}" />
                        <TextBlock Text="실장비 통신: 어댑터 연결 대기" Style="{StaticResource SmallLabelStyle}" Margin="0,5,0,0" />
                        <TextBlock Text="티칭값: 읽기 전용 경계 적용" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" Margin="0,10,0,0" />
                        <TextBlock Text="다음 단계: EtherCAT/PLC 신호 매핑" Style="{StaticResource SmallLabelStyle}" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
