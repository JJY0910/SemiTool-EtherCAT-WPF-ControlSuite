<Window x:Class="SemiTool.EtherCAT.ControlSuite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:models="clr-namespace:SemiTool.EtherCAT.ControlSuite.Models"
        mc:Ignorable="d"
        Title="SemiTool EtherCAT WPF Control Suite"
        Width="1600"
        Height="980"
        MinWidth="1360"
        MinHeight="860"
        Background="#071116"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Color x:Key="Ink">#F8FAFC</Color>
        <Color x:Key="Muted">#94A3B8</Color>
        <Color x:Key="Panel">#0E1D25</Color>
        <Color x:Key="Panel2">#122833</Color>
        <Color x:Key="Stroke">#284555</Color>
        <Color x:Key="Cyan">#37D5E8</Color>
        <Color x:Key="Green">#41F18A</Color>
        <Color x:Key="Amber">#F6C453</Color>
        <Color x:Key="Red">#F04444</Color>

        <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink}" />
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}" />
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource Panel}" />
        <SolidColorBrush x:Key="Panel2Brush" Color="{StaticResource Panel2}" />
        <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource Stroke}" />
        <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource Cyan}" />
        <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource Green}" />
        <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource Amber}" />
        <SolidColorBrush x:Key="RedBrush" Color="{StaticResource Red}" />

        <LinearGradientBrush x:Key="PanelGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#132B36" Offset="0" />
            <GradientStop Color="#0C1B22" Offset="1" />
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="DeckGradient" Center="0.45,0.35" RadiusX="0.85" RadiusY="0.85">
            <GradientStop Color="#223946" Offset="0" />
            <GradientStop Color="#0B171D" Offset="1" />
        </RadialGradientBrush>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelGradient}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="TitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="18" />
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Background" Value="#38D6C2" />
            <Setter Property="Foreground" Value="#031014" />
            <Setter Property="BorderBrush" Value="#67F7E6" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#183544" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="#3C6071" />
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#EF4444" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#FF8C8C" />
        </Style>

        <Style x:Key="StateDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Fill" Value="{StaticResource GreenBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:EquipmentState.Active}">
                    <Setter Property="Fill" Value="{StaticResource CyanBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:EquipmentState.Warning}">
                    <Setter Property="Fill" Value="{StaticResource AmberBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:EquipmentState.Fault}">
                    <Setter Property="Fill" Value="{StaticResource RedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="*" />
            <RowDefinition Height="230" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#264655" BorderThickness="0,0,0,1" Padding="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Wafer Transfer Machine Twin" Foreground="{StaticResource InkBrush}" FontSize="30" FontWeight="Bold" />
                    <TextBlock Text="{Binding OperatorMessage}" Foreground="{StaticResource MutedBrush}" FontSize="13" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#10262F" BorderBrush="#315363" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="MODE" Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{Binding OperationMode}" Foreground="{StaticResource GreenBrush}" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Background="#10262F" BorderBrush="#315363" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="LINK" Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{Binding ConnectionMode}" Foreground="{StaticResource CyanBrush}" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Button Content="EMERGENCY STOP" Command="{Binding EmergencyStopCommand}" Width="188" Height="58" Style="{StaticResource DangerButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,16,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="292" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="160" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Margin="0,0,14,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="FOUP Inventory" Style="{StaticResource TitleStyle}" Margin="0,0,0,14" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="FOUP A" Foreground="{StaticResource InkBrush}" FontSize="22" FontWeight="Bold" />
                                <TextBlock Text="Source cassette / 5 slots" Style="{StaticResource LabelStyle}" Margin="0,2,0,10" />
                                <ItemsControl ItemsSource="{Binding FoupASlots}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#123B2B" BorderBrush="#41F18A" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,8,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding SlotNumber}" Foreground="{StaticResource InkBrush}" FontWeight="Bold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding WaferId}" Foreground="{StaticResource GreenBrush}" FontWeight="SemiBold" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="FOUP B" Foreground="{StaticResource InkBrush}" FontSize="22" FontWeight="Bold" />
                                <TextBlock Text="Return cassette / 5 slots" Style="{StaticResource LabelStyle}" Margin="0,2,0,10" />
                                <ItemsControl ItemsSource="{Binding FoupBSlots}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#3A2C10" BorderBrush="#F6C453" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,0,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding SlotNumber}" Foreground="{StaticResource InkBrush}" FontWeight="Bold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding WaferId}" Foreground="{StaticResource AmberBrush}" FontWeight="SemiBold" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="Teaching Guard" Style="{StaticResource TitleStyle}" />
                        <TextBlock Text="{Binding TeachingStatus}" Style="{StaticResource ValueStyle}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding MotionPermissionText}" Foreground="{StaticResource AmberBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="112" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="2.5D Machine Twin" Style="{StaticResource TitleStyle}" FontSize="24" />
                            <TextBlock Text="Simulator values drive theta angle and blade extension. Real teaching values are not embedded." Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedRoute}" HorizontalAlignment="Right" Foreground="{StaticResource CyanBrush}" FontWeight="Bold" FontSize="16" />
                    </Grid>

                    <Viewbox Grid.Row="1" Stretch="Uniform">
                        <Canvas Width="980" Height="620">
                            <Rectangle Width="980" Height="620" RadiusX="18" RadiusY="18" Fill="{StaticResource DeckGradient}" Stroke="#355466" StrokeThickness="2" />
                            <Rectangle Canvas.Left="42" Canvas.Top="40" Width="896" Height="520" RadiusX="14" RadiusY="14" Fill="#10212A" Stroke="#45697C" StrokeThickness="2" />
                            <Path Data="M95,82 L885,82 L830,145 L150,145 Z" Fill="#1E3945" Stroke="#68A0B9" StrokeThickness="1.5" Opacity="0.78" />
                            <Path Data="M120,540 L860,540" Stroke="#526F7D" StrokeThickness="6" />

                            <!-- Route guide arcs. The cyan active route intentionally separates rotation from extension. -->
                            <Ellipse Canvas.Left="260" Canvas.Top="120" Width="460" Height="360" Stroke="#2B5564" StrokeThickness="18" Opacity="0.42" />
                            <Ellipse Canvas.Left="260" Canvas.Top="120" Width="460" Height="360" Stroke="#51D8F0" StrokeThickness="3" StrokeDashArray="14 12" Opacity="0.9" />

                            <!-- Chambers -->
                            <Border Canvas.Left="410" Canvas.Top="60" Width="160" Height="116" Background="#172C36" BorderBrush="#6FA5B9" BorderThickness="2" CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="CHAMBER A" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource InkBrush}" FontWeight="Bold" />
                                    <Rectangle Grid.Row="1" Margin="24,16,24,36" Fill="#D8E4EA" Stroke="#8AA7B5" />
                                    <Rectangle Grid.Row="1" Height="7" Margin="20,0,20,18" VerticalAlignment="Bottom" Fill="#9EB4C1" />
                                    <Ellipse Grid.Row="1" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" Fill="{StaticResource GreenBrush}" />
                                </Grid>
                            </Border>
                            <Border Canvas.Left="118" Canvas.Top="180" Width="166" Height="124" Background="#172C36" BorderBrush="#6FA5B9" BorderThickness="2" CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="CHAMBER B" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource InkBrush}" FontWeight="Bold" />
                                    <Ellipse Grid.Row="1" Width="76" Height="28" Fill="#D8E4EA" Stroke="#8AA7B5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Rectangle Grid.Row="1" Height="7" Margin="20,0,20,18" VerticalAlignment="Bottom" Fill="#9EB4C1" />
                                </Grid>
                            </Border>
                            <Border Canvas.Left="696" Canvas.Top="180" Width="166" Height="124" Background="#172C36" BorderBrush="#6FA5B9" BorderThickness="2" CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="CHAMBER C" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource InkBrush}" FontWeight="Bold" />
                                    <Ellipse Grid.Row="1" Width="76" Height="28" Fill="#D8E4EA" Stroke="#8AA7B5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Rectangle Grid.Row="1" Height="7" Margin="20,0,20,18" VerticalAlignment="Bottom" Fill="#9EB4C1" />
                                </Grid>
                            </Border>

                            <!-- FOUP cassettes -->
                            <Border Canvas.Left="150" Canvas.Top="410" Width="138" Height="132" Background="#081118" BorderBrush="#41F18A" BorderThickness="2" CornerRadius="8">
                                <StackPanel Margin="14">
                                    <TextBlock Text="FOUP A" Foreground="{StaticResource GreenBrush}" FontWeight="Bold" HorizontalAlignment="Center" />
                                    <Rectangle Height="14" Fill="#153F2E" Stroke="#41F18A" Margin="0,10,0,4" />
                                    <Rectangle Height="14" Fill="#153F2E" Stroke="#41F18A" Margin="0,0,0,4" />
                                    <Rectangle Height="14" Fill="#205B42" Stroke="#41F18A" Margin="0,0,0,4" />
                                    <Rectangle Height="14" Fill="#153F2E" Stroke="#41F18A" Margin="0,0,0,4" />
                                    <Rectangle Height="14" Fill="#153F2E" Stroke="#41F18A" />
                                </StackPanel>
                            </Border>
                            <Border Canvas.Left="692" Canvas.Top="410" Width="138" Height="132" Background="#081118" BorderBrush="#F6C453" BorderThickness="2" CornerRadius="8">
                                <StackPanel Margin="14">
                                    <TextBlock Text="FOUP B" Foreground="{StaticResource AmberBrush}" FontWeight="Bold" HorizontalAlignment="Center" />
                                    <Rectangle Height="14" Fill="#33240C" Stroke="#F6C453" Margin="0,10,0,4" />
                                    <Rectangle Height="14" Fill="#33240C" Stroke="#F6C453" Margin="0,0,0,4" />
                                    <Rectangle Height="14" Fill="#33240C" Stroke="#F6C453" Margin="0,0,0,4" />
                                    <Rectangle Height="14" Fill="#33240C" Stroke="#F6C453" Margin="0,0,0,4" />
                                    <Rectangle Height="14" Fill="#33240C" Stroke="#F6C453" />
                                </StackPanel>
                            </Border>

                            <!-- Robot base, home axes, and bound blade transform. -->
                            <Ellipse Canvas.Left="380" Canvas.Top="220" Width="220" Height="220" Fill="#172A34" Stroke="#7EA2B5" StrokeThickness="4" />
                            <Ellipse Canvas.Left="420" Canvas.Top="260" Width="140" Height="140" Fill="#0C1B22" Stroke="#B7D0DA" StrokeThickness="3" />
                            <Line X1="490" Y1="245" X2="490" Y2="415" Stroke="#F04444" StrokeThickness="2" StrokeDashArray="6 6" />
                            <Line X1="405" Y1="330" X2="575" Y2="330" Stroke="#F04444" StrokeThickness="2" StrokeDashArray="6 6" />
                            <TextBlock Canvas.Left="510" Canvas.Top="308" Text="HOME 0 deg" Foreground="#F9A8A8" FontWeight="Bold" FontSize="13" />
                            <Ellipse Canvas.Left="462" Canvas.Top="302" Width="56" Height="56" Fill="#9FB6C4" Stroke="#E2EEF4" StrokeThickness="2" />

                            <Canvas Canvas.Left="490" Canvas.Top="330" RenderTransformOrigin="0,0.5">
                                <Canvas.RenderTransform>
                                    <RotateTransform Angle="{Binding BladePose.VisualAngle}" />
                                </Canvas.RenderTransform>
                                <Grid Canvas.Left="0" Canvas.Top="-20" Width="{Binding BladePose.BladeLength}" Height="40">
                                    <Rectangle Height="24" RadiusX="10" RadiusY="10" Fill="#DDE9EF" Stroke="#FFFFFF" StrokeThickness="2" VerticalAlignment="Center" />
                                    <Rectangle Height="10" Margin="20,0,14,0" Fill="#8CA6B5" Opacity="0.45" VerticalAlignment="Center" />
                                    <Ellipse Width="38" Height="38" Fill="#79F2D1" Stroke="#ECFEFF" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Canvas>

                            <TextBlock Canvas.Left="340" Canvas.Top="455" Text="{Binding BladePose.CurrentStation}" Foreground="{StaticResource InkBrush}" FontSize="18" FontWeight="Bold" />
                            <TextBlock Canvas.Left="340" Canvas.Top="482" Text="{Binding BladePose.Direction}" Foreground="{StaticResource CyanBrush}" FontSize="15" FontWeight="SemiBold" />
                        </Canvas>
                    </Viewbox>

                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border Background="#10262F" BorderBrush="#315363" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="PHASE" Style="{StaticResource LabelStyle}" />
                                <TextBlock Text="{Binding BladePose.TransferPhase}" Style="{StaticResource ValueStyle}" />
                                <TextBlock Text="{Binding BladePose.Reach}" Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#10262F" BorderBrush="#315363" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="VACUUM" Style="{StaticResource LabelStyle}" />
                                <TextBlock Text="{Binding BladePose.Vacuum}" Style="{StaticResource ValueStyle}" />
                                <TextBlock Text="{Binding BladePose.Wafer}" Foreground="{StaticResource AmberBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#10262F" BorderBrush="#315363" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="HOME REFERENCE" Style="{StaticResource LabelStyle}" />
                                <TextBlock Text="{Binding BladePose.HomeReference}" Style="{StaticResource ValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Background="#10262F" BorderBrush="#315363" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <TextBlock Text="MOTION PHASE" Style="{StaticResource LabelStyle}" />
                                <TextBlock Text="{Binding MotionPhase}" Style="{StaticResource ValueStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="2" Margin="14,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Simulator Controls" Style="{StaticResource TitleStyle}" />
                        <TextBlock Text="{Binding OfflineSimulationStatus}" Style="{StaticResource ValueStyle}" Margin="0,8,0,10" />
                        <WrapPanel>
                            <Button Content="SIM CONNECT" Command="{Binding ConnectOfflineSimulatorCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Content="VERIFY SLOTS" Command="{Binding VerifySlotMapCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="STEP PIPELINE" Command="{Binding AdvanceSimulationCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="RESET" Command="{Binding ResetCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Route / Chamber Door" Style="{StaticResource TitleStyle}" />
                        <WrapPanel Margin="0,10,0,4">
                            <Button Content="A -> Chamber A" Command="{Binding SelectRouteCommand}" CommandParameter="FOUP A -> CHAMBER A" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="A -> Chamber B" Command="{Binding SelectRouteCommand}" CommandParameter="FOUP A -> CHAMBER B" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="B -> Chamber C" Command="{Binding SelectRouteCommand}" CommandParameter="FOUP B -> CHAMBER C" Style="{StaticResource SecondaryButtonStyle}" />
                        </WrapPanel>
                        <ItemsControl ItemsSource="{Binding Chambers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding DoorText}"
                                            Command="{Binding DataContext.ToggleChamberDoorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Height="34"
                                            Margin="0,0,8,0"
                                            Background="#183544"
                                            Foreground="{StaticResource InkBrush}"
                                            BorderBrush="#3C6071" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource PanelStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Pipeline Steps" Style="{StaticResource TitleStyle}" Margin="0,0,0,12" />
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <ProgressBar Height="16" Minimum="0" Maximum="100" Value="{Binding SequenceProgress}" Foreground="{StaticResource CyanBrush}" Background="#071116" />
                            <TextBlock Text="{Binding SequenceProgress, StringFormat={}{0}%}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" Margin="0,5,0,0" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding SequenceSteps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="18" Height="18" Style="{StaticResource StateDotStyle}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Right" FontWeight="Bold" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34*" />
                <ColumnDefinition Width="34*" />
                <ColumnDefinition Width="32*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Margin="0,0,14,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Interlock Matrix" Style="{StaticResource TitleStyle}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Interlocks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="76" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Style="{StaticResource StateDotStyle}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding ResultText}" Foreground="{StaticResource CyanBrush}" FontWeight="Bold" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Margin="0,0,14,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Command Audit" Style="{StaticResource TitleStyle}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding CommandAudits}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding ResultText}" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Allowed}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding CommandType}" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{Binding Reason}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Event Log / Axis State" Style="{StaticResource TitleStyle}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <ItemsControl ItemsSource="{Binding AxisStatuses}" Margin="0,0,10,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{Binding Position}" Foreground="{StaticResource CyanBrush}" FontSize="11" />
                                        <TextBlock Text="{Binding Home}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding AlarmEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                        <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{StaticResource InkBrush}" FontSize="11" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
